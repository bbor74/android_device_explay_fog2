<?xml version="1.0" encoding="utf-8"?>
<resources>

    <!-- Height of the bottom navigation / system bar. -->
    <dimen name="navigation_bar_height">42dp</dimen>
    <!-- Height of the bottom navigation bar in landscape; often the same as @dimen/navigation_bar_height -->
    <dimen name="navigation_bar_height_landscape">42dp</dimen>
    <!-- Height of the bottom navigation bar in portrait -->
    <dimen name="navigation_bar_height_portrait">42dp</dimen>
    <!-- Width of the navigation bar when it is placed vertically on the screen -->
    <dimen name="navigation_bar_width">42dp</dimen>

</resources>
