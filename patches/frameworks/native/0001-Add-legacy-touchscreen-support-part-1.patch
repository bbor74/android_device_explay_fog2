From 23afa1831b60ecf6d1f68ca37dd8772e1a6cb242 Mon Sep 17 00:00:00 2001
From: Boris Belyaev <bbor1974@gmail.com>
Date: Mon, 2 Jun 2025 16:47:17 +0400
Subject: [PATCH 1/4] Add legacy touchscreen support - part 1

Change-Id: I2a801c289a91b3d7d7910589b808abd130df0703
---
 services/inputflinger/Android.mk      |  5 +++++
 services/inputflinger/InputReader.cpp | 15 +++++++++++++--
 2 files changed, 18 insertions(+), 2 deletions(-)

diff --git a/services/inputflinger/Android.mk b/services/inputflinger/Android.mk
index e23e2ea..64cddc6 100644
--- a/services/inputflinger/Android.mk
+++ b/services/inputflinger/Android.mk
@@ -45,6 +45,11 @@ LOCAL_EXPORT_C_INCLUDE_DIRS := $(LOCAL_PATH)
 
 LOCAL_MODULE := libinputflinger
 
+
+ifeq ($(BOARD_USE_LEGACY_TOUCHSCREEN),true)
+LOCAL_CFLAGS += -DLEGACY_TOUCHSCREEN
+endif
+
 include $(BUILD_SHARED_LIBRARY)
 
 include $(call all-makefiles-under,$(LOCAL_PATH))
diff --git a/services/inputflinger/InputReader.cpp b/services/inputflinger/InputReader.cpp
index 99cd496..f4f5d08 100644
--- a/services/inputflinger/InputReader.cpp
+++ b/services/inputflinger/InputReader.cpp
@@ -6708,7 +6708,11 @@ void MultiTouchInputMapper::syncTouch(nsecs_t when, RawState* outState) {
         if (!inSlot->isInUse()) {
             continue;
         }
-
+#ifdef LEGACY_TOUCHSCREEN
+        if ((inSlot->getX() == 0) && (inSlot->getY() == 0)) {
+            continue;
+        }
+#endif
         if (outCount >= MAX_POINTERS) {
 #if DEBUG_POINTERS
             ALOGD("MultiTouch device %s emitted more than maximum of %d pointers; "
@@ -6742,8 +6746,11 @@ void MultiTouchInputMapper::syncTouch(nsecs_t when, RawState* outState) {
         bool isHovering = mTouchButtonAccumulator.getToolType() != AMOTION_EVENT_TOOL_TYPE_MOUSE
                 && (mTouchButtonAccumulator.isHovering()
                         || (mRawPointerAxes.pressure.valid && inSlot->getPressure() <= 0));
+#ifdef LEGACY_TOUCHSCREEN
+        outPointer.isHovering = false;
+#else
         outPointer.isHovering = isHovering;
-
+#endif
         // Assign pointer id using tracking id if available.
         mHavePointerIds = true;
         int32_t trackingId = inSlot->getTrackingId();
@@ -6768,7 +6775,11 @@ void MultiTouchInputMapper::syncTouch(nsecs_t when, RawState* outState) {
         } else {
             outPointer.id = id;
             outState->rawPointerData.idToIndex[id] = outCount;
+#ifdef LEGACY_TOUCHSCREEN
+            outState->rawPointerData.markIdBit(id, outPointer.isHovering);
+#else
             outState->rawPointerData.markIdBit(id, isHovering);
+#endif
             newPointerIdBits.markBit(id);
         }
 
-- 
2.17.1

