From 39164580a18504524c5a812d443240f5d926a834 Mon Sep 17 00:00:00 2001
From: "zj@rock-chips.com" <zj@rock-chips.com>
Date: Fri, 17 Mar 2017 15:37:46 +0800
Subject: [PATCH] use BOARD_HAVE_BLUETOOTH to control apk compile

Signed-off-by: zj <zj@rock-chips.com>

Change-Id: I0727d22ef080558facca0322189c04f73e069761
---
 Android.mk | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/Android.mk b/Android.mk
index b8eaaddb..a0dbf322 100755
--- a/Android.mk
+++ b/Android.mk
@@ -1,3 +1,4 @@
+ifeq ($(strip $(BOARD_HAVE_BLUETOOTH)),true)
 LOCAL_PATH:= $(call my-dir)
 include $(CLEAR_VARS)
 
@@ -35,3 +36,4 @@ LOCAL_PROGUARD_ENABLED := disabled
 include $(BUILD_PACKAGE)
 
 include $(call all-makefiles-under,$(LOCAL_PATH))
+endif
-- 
