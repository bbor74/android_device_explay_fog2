From d5ed0a514de354779a46ce0b51df81d36c7190f0 Mon Sep 17 00:00:00 2001
From: Sultanxda <sultanxda@gmail.com>
Date: Fri, 20 Nov 2015 15:23:03 -0800
Subject: [PATCH 2/2] Snap: Disable panorama feature

Extremely buggy.
---
 src/com/android/camera/ui/ModuleSwitcher.java | 6 ++++++
 1 file changed, 6 insertions(+)

diff --git a/src/com/android/camera/ui/ModuleSwitcher.java b/src/com/android/camera/ui/ModuleSwitcher.java
index 7c06dbe77..4c78e782e 100644
--- a/src/com/android/camera/ui/ModuleSwitcher.java
+++ b/src/com/android/camera/ui/ModuleSwitcher.java
@@ -114,6 +114,9 @@ public class ModuleSwitcher extends RotateImageView
         // Always decrement one because of GCam.
         --numDrawIds;
 
+        // Always decrement one because of pano.
+        --numDrawIds;
+
         int[] drawids = new int[numDrawIds];
         int[] moduleids = new int[numDrawIds];
         int ix = 0;
@@ -124,6 +127,9 @@ public class ModuleSwitcher extends RotateImageView
             if (i == GCAM_MODULE_INDEX) {
                 continue; // don't add to UI
             }
+            if (i == WIDE_ANGLE_PANO_MODULE_INDEX) {
+                continue; // don't add to UI
+            }
             moduleids[ix] = i;
             drawids[ix++] = DRAW_IDS[i];
         }
-- 
