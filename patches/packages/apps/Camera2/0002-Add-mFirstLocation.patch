From 51f5ae2665afd896307657cfa77fbb9ccf655a4a Mon Sep 17 00:00:00 2001
From: Boris Belyaev <bbor1974@gmail.com>
Date: Mon, 28 Apr 2025 17:37:23 +0400
Subject: [PATCH 2/2] Add mFirstLocation

Fix error:
D/CAM_LcyLocProvider( 1692): No location received yet.

Change-Id: I4874ac52efe3bbac00c355fa256ae3d415e97b10
---
 src/com/android/camera/app/LegacyLocationProvider.java | 9 ++++++++-
 1 file changed, 8 insertions(+), 1 deletion(-)

diff --git a/src/com/android/camera/app/LegacyLocationProvider.java b/src/com/android/camera/app/LegacyLocationProvider.java
index 0bda5bfae..ffd25f953 100644
--- a/src/com/android/camera/app/LegacyLocationProvider.java
+++ b/src/com/android/camera/app/LegacyLocationProvider.java
@@ -32,6 +32,7 @@ public class LegacyLocationProvider implements LocationProvider {
     private Context mContext;
     private android.location.LocationManager mLocationManager;
     private boolean mRecordLocation;
+    private Location mFirstLocation;
 
     LocationListener [] mLocationListeners = new LocationListener[] {
             new LocationListener(android.location.LocationManager.GPS_PROVIDER),
@@ -40,6 +41,7 @@ public class LegacyLocationProvider implements LocationProvider {
 
     public LegacyLocationProvider(Context context) {
         mContext = context;
+        mFirstLocation = new Location(android.location.LocationManager.GPS_PROVIDER);
     }
 
     @Override
@@ -52,6 +54,10 @@ public class LegacyLocationProvider implements LocationProvider {
             if (l != null) return l;
         }
         Log.d(TAG, "No location received yet.");
+        if (mFirstLocation != null) {
+            Log.d(TAG, "Use first location.");
+            return mFirstLocation;
+        }
         return null;
     }
 
@@ -137,7 +143,8 @@ public class LegacyLocationProvider implements LocationProvider {
                 return;
             }
             if (!mValid) {
-                Log.d(TAG, "Got first location.");
+                Log.d(TAG, "Got first location:" + newLocation);
+                mFirstLocation.set(newLocation);
             }
             mLastLocation.set(newLocation);
             mValid = true;
-- 
