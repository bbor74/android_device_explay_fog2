From 5f57cfb0c47c26a8d953bdf3009f3c92c264f538 Mon Sep 17 00:00:00 2001
From: Boris Belyaev <bbor1974@gmail.com>
Date: Sat, 28 Feb 2026 10:35:31 +0400
Subject: [PATCH 4/5] init: Add 'wifi' to insmod_modules command

Change-Id: I2eb31a82c0c0d2fe19a1985ce61aac2b4071356a
---
 init/builtins.cpp | 43 ++++++++++++++++++++++++++++++++++++++++++-
 1 file changed, 42 insertions(+), 1 deletion(-)

diff --git a/init/builtins.cpp b/init/builtins.cpp
index 9a6499c..3ff0457 100755
--- a/init/builtins.cpp
+++ b/init/builtins.cpp
@@ -1194,6 +1194,8 @@ static int do_insmod_modules(const std::vector<std::string>& args)
 {
 ERROR("-----------rogge---------------do_insmod_modules");
     const char *modules = args[1].c_str();
+    const char *arg2 = args[2].c_str();
+    const char *arg3 = args[3].c_str();
     int ret = 0;
     char options[1];
 
@@ -1213,6 +1215,9 @@ ERROR("-----------rogge---------------do_insmod_modules");
     //char num[1];
 
     char str[128];
+    char opt[128];
+
+//    char wlan_type[PROP_VALUE_MAX];
 
     memset(back_name, 0, 64);
     memset(back_node, 0, 64);
@@ -1221,9 +1226,11 @@ ERROR("-----------rogge---------------do_insmod_modules");
     //memset(num, 0, 1);
 
     memset(str, 0, 128);
+    memset(opt, 0, 128);
 
     if (strstr(modules, "camera"))
     {
+        ERROR("insmod_modules: camera");
         //fopen back_name
         fp = fopen("/sys/devices/camera/back_name", "r");
         if (NULL == fp )
@@ -1354,9 +1361,43 @@ ERROR("-----------rogge---------------do_insmod_modules");
             }
         }
     }
+    else if (strstr(modules, "wifi"))
+    {
+        ERROR("insmod_modules: wifi \n");
+//        ret = property_get("ro.inet.wlan.type", wlan_type);
+        std::string wlan_type = property_get("ro.inet.wlan.type");
+        if (wlan_type.empty())
+            {
+               wlan_type = "8189es";
+                ERROR("(wifi) no 'ro.inet.wlan.type' found, use default: %s \n", wlan_type.c_str());
+            } else {
+                ERROR("(wifi) 'ro.inet.wlan.type' found, use: %s \n", wlan_type.c_str());
+            }
+
+/*        if (!ret)
+            {
+                strcpy(wlan_type, "8189es");
+                ERROR("(wifi) no 'ro.inet.wlan.type' found, use default: %s \n", wlan_type);
+            } else {
+                ERROR("(wifi) 'ro.inet.wlan.type' found, use: %s \n", wlan_type);
+            }*/
+
+          memset(str, 0, 128);
+          memset(opt, 0, 128);
+
+            sprintf(str, "/system/lib/modules/%s.ko", wlan_type.c_str());
+            sprintf(opt, "%s %s", arg2, arg3);
+            ret = insmod(str, opt);
+            if(ret < 0)
+            {
+                ERROR("(wifi) insmod %s %s, err: %s \n", str, opt, strerror(errno));
+            } else {
+                ERROR("(wifi) insmod %s %s \n", str, opt);
+            }
+    }
     else
     {
-        ERROR("insmod_modules insmod camera failed");
+        ERROR("insmod_modules insmod camera and wifi failed \n");
     }
 
     return 1;
-- 
2.43.0

