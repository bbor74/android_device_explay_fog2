# label graphics device with a new type, we need
# to allow write operation from appdomain

# gpu device labeling
/dev/mali0              u:object_r:gpu_device:s0

# disp device labeling
/dev/disp               u:object_r:disp_device:s0

/dev/rfkill                  u:object_r:rfkill_device:s0

/system/bin/sensors.sh     u:object_r:sensors_exec:s0

/databk(/.*)?		u:object_r:databk_file:s0

/dev/block/nandd                   u:object_r:system_block_device:s0
/dev/block/nandg                   u:object_r:cache_block_device:s0
/dev/block/nandh                   u:object_r:databk_block_device:s0
/dev/block/nandi                   u:object_r:userdata_block_device:s0
